# Пароль базы. Установщик генерирует случайный.
POSTGRES_PASSWORD=change-me

# Домен, по которому открывается приложение (для сертификата HTTPS).
DOMAIN=fit.example.ru

# Демо-данные при первом запуске: тренер +7 900 000-00-01, пароль 1234.
# Для настоящих пользователей поставьте 0.
DEMO=1

# Администратор сервиса (админка /#/admin). Создаётся при старте, если нет.
ADMIN_PHONE=79990000000
ADMIN_PASSWORD=change-me
